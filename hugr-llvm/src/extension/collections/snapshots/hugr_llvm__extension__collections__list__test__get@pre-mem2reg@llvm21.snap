  %"05" = load ptr, ptr %"0", align 8
  %"16" = load { i1, i64 }, ptr %"1", align 4
  %mrv = insertvalue { ptr, { i1, i64 } } poison, ptr %"05", 0
  %mrv7 = insertvalue { ptr, { i1, i64 } } %mrv, { i1, i64 } %"16", 1
  ret { ptr, { i1, i64 } } %mrv7
